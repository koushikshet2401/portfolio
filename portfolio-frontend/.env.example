# ==============================================================================
# Portfolio Frontend (Next.js) Environment Variables Template
# ==============================================================================
# Copy this file to '.env.local' and adjust if your backend runs on a different port:
# cp .env.example .env.local
# ==============================================================================

# Backend API Base URL (Must match your backend PORT and /api route prefix)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Client-side Site URL (Used for canonical links, metadata, and tracking)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ==============================================================================
# Production Example:
# NEXT_PUBLIC_API_URL=https://api.yourportfolio.com/api
# NEXT_PUBLIC_SITE_URL=https://yourportfolio.com
# ==============================================================================
