# ==============================================================================
# Portfolio Backend Environment Variables Template
# ==============================================================================
# Copy this file to '.env' and fill in your actual values:
# cp .env.example .env
# ==============================================================================

# Server Environment & Port
NODE_ENV=development
PORT=5000

# MongoDB Connection String
# Option 1: MongoDB Atlas (Cloud - Recommended)
# Replace <username>, <password>, and <cluster-url> with your Atlas cluster details:
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/portfolio?retryWrites=true&w=majority

# Option 2: Local MongoDB (if running MongoDB locally on your machine)
# MONGODB_URI=mongodb://127.0.0.1:27017/portfolio

# JWT Secret Key (Used for signing admin authentication tokens)
# Generate a strong 64-byte random string, e.g. using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_min_32_characters_random_string

# Admin Authentication Credentials
# The email address you will use to log into the admin dashboard
ADMIN_EMAIL=admin@example.com

# Admin Password Hash (bcrypt hash of your admin password)
# DO NOT store your plain password here!
# Generate your bcrypt hash by running this in terminal:
# node -e "const bcrypt = require('bcryptjs'); console.log(bcrypt.hashSync('YourSecurePasswordHere', 10));"
ADMIN_PASSWORD_HASH=$2a$10$exampleBcryptHashPlaceHolderReplaceWithYourGeneratedHash

# Frontend Client URLs (Allowed origins for CORS & Cookies)
FRONTEND_URL=http://localhost:3000
FRONTEND_PUBLIC_URL=http://localhost:5500
# For Production Deployment:
# FRONTEND_URL=https://your-portfolio-domain.com

